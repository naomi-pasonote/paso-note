rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isPasswordUser() {
      return request.auth != null
        && request.auth.token.firebase.sign_in_provider == 'password';
    }

    // 「おでかけ安心」と「Paso Note」は、ログインした本人UIDの配下だけを使う。
    // 別アカウントは他人のUID配下を読めず、書けない。
    match /users/{userId} {
      allow read, write: if isPasswordUser() && request.auth.uid == userId;

      match /{document=**} {
        allow read, write: if isPasswordUser() && request.auth.uid == userId;
      }
    }

    // 旧Paso Noteの共通コレクションは復旧用データとして残すが、
    // 公開・通常アクセスはしない。新しい同期先は users/{uid}/... 配下。
    match /flamencoLessons/{docId} {
      allow read, write: if false;
    }
    match /flamencoGeneralNotes/{docId} {
      allow read, write: if false;
    }
    match /flamencoDirectIssues/{docId} {
      allow read, write: if false;
    }
    match /flamencoMeta/{docId} {
      allow read, write: if false;
    }
    match /flamencoNote/{docId} {
      allow read, write: if false;
    }

    // 上記以外もすべて拒否。
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
